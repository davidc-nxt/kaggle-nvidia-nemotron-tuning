# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored.

# Kaggle API token (new-style short-lived token, prefix KGAT_).
# Generate at https://www.kaggle.com/settings under "API".
KAGGLE_API_TOKEN=KGAT_replace_me

# Optional: classic kaggle.json fields (only needed if you fall back to ~/.kaggle/kaggle.json auth).
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_classic_key
